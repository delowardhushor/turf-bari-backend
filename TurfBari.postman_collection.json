								"email"
							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Rahim Uddin\",\n  \"email\": \"user@turfbari.com\",\n  \"password\": \"password123\"\n}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"auth": {
							"type": "noauth"
						}
					},
					"response": [],
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"if (pm.response.code === 200 || pm.response.code === 201) {",
									"    var d = pm.response.json().data;",
									"    if (d && d.accessToken) { pm.collectionVariables.set('auth_token', d.accessToken); }",
									"    if (d && d.user && d.user.id) { pm.collectionVariables.set('user_id', d.user.id); }",
									"}"
								]
							}
						}
					]
