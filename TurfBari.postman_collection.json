							]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n  \"name\": \"Main Ground\",\n  \"description\": \"Floodlit turf, suitable for 7-a-side\",\n  \"companyId\": \"{{company_id}}\",\n  \"sports\": [\n    \"cricket\",\n    \"football\"\n  ],\n  \"slotDuration\": 90,\n  \"advancePayment\": true,\n  \"operatingHours\": {\n    \"start\": \"06:00\",\n    \"end\": \"23:00\"\n  },\n  \"pricingConfig\": {\n    \"basePrice\": 1500,\n    \"weekendPrice\": 2200,\n    \"timeRules\": [\n      {\n        \"startTime\": \"06:00\",\n        \"endTime\": \"12:00\",\n        \"price\": 1200\n      },\n      {\n        \"startTime\": \"17:00\",\n        \"endTime\": \"23:00\",\n        \"price\": 2000\n      }\n    ]\n  },\n  \"campaigns\": [\n    {\n      \"name\": \"Eid Offer\",\n      \"startDate\": \"2026-06-01\",\n      \"endDate\": \"2026-06-10\",\n      \"discountPercentage\": 10\n    }\n  ],\n  \"status\": \"active\"\n}",
