NODE_ENV=development
PORT=5002
DATABASE_URL=mongodb://127.0.0.1:27017/turfbari
BCRYPT_SALT_ROUNDS=12
JWT_SECRET=your-jwt-secret-key-string
JWT_EXPIRES_IN=7d

# Seed (yarn seed:admin) - required only when creating the first super admin
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@turfbari.com
SEED_ADMIN_PASSWORD=change-me-please

# Dev shortcut: fixed OTP and no SMS sent (e.g. 123456). Leave empty to send real codes. Ignored when NODE_ENV=production.
OTP_STATIC_CODE=

# OTP send limits (per phone/email, and per client IP)
OTP_COOLDOWN_SECONDS=60
OTP_MAX_PER_HOUR=5
OTP_MAX_PER_DAY=10
OTP_MAX_PER_IP_PER_HOUR=20

# Reverse-proxy hops in front of the app (set to 1 behind nginx/a load balancer so IP limits see real clients)
TRUST_PROXY=0

# MiMSMS SMS gateway
SMS_API_URL=https://api.mimsms.com/api/SmsSending/SMS
SMS_API_KEY=
SMS_USER_NAME=
SMS_SENDER_ID=
SMS_TRANSACTION_TYPE=T

# Where uploaded ground photos are stored (served at /uploads). Defaults to ./uploads;
# on hosts with ephemeral disks point this at a persistent volume.
UPLOAD_DIR=
