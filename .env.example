NODE_ENV=development
PORT=5002
DATABASE_URL=mongodb://127.0.0.1:27017/turfbari
BCRYPT_SALT_ROUNDS=12
JWT_SECRET=your-jwt-secret-key-string
JWT_EXPIRES_IN=7d

# Seed (yarn seed:admin) - required only when creating the first super admin
SEED_ADMIN_NAME=Super Admin
SEED_ADMIN_EMAIL=admin@turfbari.com
SEED_ADMIN_PASSWORD=change-me-please

# Fixed OTP used until an SMS/email provider is added (empty = random codes)
OTP_STATIC_CODE=123456
